# Copy to .env and edit. Every value shown is the default.
PORT=3000

PG_HOST=localhost
PG_PORT=54321
PG_USER=ratelock
PG_PASSWORD=ratelock123
PG_DATABASE=ratelock
REDIS_URL=redis://localhost:6379

APP_POOL_SIZE=10
SYS_POOL_SIZE=4
ACQUIRE_TIMEOUT_MS=10000

# plain | own_usage | conex | holder_whole | holder_overstay
RL_POLICY=holder_overstay
RL_ALPHA=1
RL_BETA=1
RL_HOLD_DEBIT_CAP=20
RL_DEBT_CAP=50
RL_DEBT_DECAY_PER_SEC=0.5
RL_GAMMA=1.2
RL_BASELINE_WINDOW_SEC=300
RL_BASELINE_MIN_HOLDS=20
RL_BASELINE_MIN_KEYS=3
RL_BASELINE_REFRESH_MS=2000
RL_LOAD_MULTIPLIER=off
RL_FAIL_OPEN=true
RL_BUCKET_IDLE_TTL_SEC=7200
RL_TIER_CACHE_TTL_SEC=300
RL_CALIBRATOR_INTERVAL_SEC=15
RL_RUN_ID=dev
LOG_BATCH_MS=500

ADMIN_TOKEN=dev-admin-token
